# Supabase — public values only. The MCP server is a pure OAuth 2.1
# Protected Resource; authentication is delegated to Supabase Auth and
# row-level security is enforced by Postgres via auth.uid(). There is
# deliberately NO service role key and NO Google OAuth credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: comma-separated list of Supabase OAuth client IDs allowed to
# call this MCP server. Leave empty to accept any OAuth-issued token
# (required for Claude Desktop / Claude Code's Dynamic Client Registration).
MCP_ALLOWED_CLIENT_IDS=

# MCP Server
MCP_SERVER_PORT=4201
MCP_BASE_URL=http://localhost:4201
# Prospify web app URL used by authenticated sync/refresh tools
PROSPIFY_APP_URL=https://prospify.app
